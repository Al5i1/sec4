{
  "manifest_version": 3,
  "name": "SEC4 — مزامنة بلاكبورد جامعة البحرين التلقائية",
  "version": "1.0.0",
  "description": "يفحص بلاكبورد جامعة البحرين كل 12 ساعة ويرفع أي ملفات أو أسابيع جديدة تلقائياً إلى منصة SEC4",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://blackboard.uob.edu.bh/*",
    "https://*.blackboard.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://blackboard.uob.edu.bh/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
